[Unit]
Description=XeroStreams isolated local media scan
ConditionPathExists=/var/lib/xero-media-scan/episodes.json
[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=xero-media-scan
WorkingDirectory=/var/lib/xero-media-scan
ExecStart=/usr/bin/python3 /opt/xero-media-scan/scanner.py /var/lib/xero-media-scan/episodes.json --media-root /srv/xero-media-scan --db /var/lib/xero-media-scan/scan.sqlite --credits --recaps
StandardOutput=truncate:/var/lib/xero-media-scan/results.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
UMask=0077
CPUQuota=50%
MemoryMax=512M
TasksMax=32
TimeoutStartSec=12h
