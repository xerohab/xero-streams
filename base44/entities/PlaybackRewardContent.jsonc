{
  "name": "PlaybackRewardContent",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "media_url_sha256": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "operator_media_probe",
        "provider_api"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "video_id",
    "duration_seconds",
    "media_url_sha256",
    "verified_at",
    "source"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}