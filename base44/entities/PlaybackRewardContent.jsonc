{
  "name": "PlaybackRewardContent",
  "type": "object",
  "properties": {
    "task_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "task_reference": {
            "type": "string"
          },
          "required_seconds": {
            "type": "number"
          },
          "full_content": {
            "type": "boolean"
          }
        }
      }
    },
    "video_id": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "media_url_sha256": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "operator_media_probe",
        "provider_api"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "video_id",
    "duration_seconds",
    "media_url_sha256",
    "verified_at",
    "source"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}