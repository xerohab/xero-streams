{
  "name": "Franchise",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Franchise name e.g. American Pie, Fast & Furious"
    },
    "description": {
      "type": "string",
      "description": "Franchise description"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover/poster image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "action",
        "comedy",
        "drama",
        "documentary",
        "horror",
        "sci-fi",
        "thriller",
        "education",
        "music",
        "crime",
        "mystery",
        "fantasy",
        "romance",
        "animation",
        "adventure",
        "other"
      ],
      "description": "Franchise category"
    },
    "parent_id": {
      "type": "string",
      "description": "ID of the parent franchise, if this is a sub-franchise"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "content_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last genuine admin edit, used for 'UPDATED' badging"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}