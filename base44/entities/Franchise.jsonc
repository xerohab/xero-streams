{
  "name": "Franchise",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Franchise name e.g. American Pie, Fast & Furious"
    },
    "description": {
      "type": "string",
      "description": "Franchise description"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover/poster image URL"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}