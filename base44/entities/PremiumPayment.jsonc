{
  "name": "PremiumPayment",
  "type": "object",
  "properties": {
    "perksphere_link_uuid": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "capture_id": {
      "type": "string"
    },
    "expected_amount": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "request_reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "created",
        "completed"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "plan_id",
    "expected_amount",
    "currency",
    "request_reference",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}