{
  "name": "ContentRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "fulfilled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "id": "user_id"
          }
        ]
      }
    },
    "create": {
      "user_condition": {
        "id": "user_id"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}