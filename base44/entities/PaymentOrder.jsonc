{
  "name": "PaymentOrder",
  "type": "object",
  "properties": {
    "receipt_reference": {
      "type": "string"
    },
    "capture_token_hash": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "amount_value": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "completed",
        "refunded",
        "reversed"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "capture_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    },
    "product_type": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "format": {
      "type": "string"
    }
  },
  "required": [
    "receipt_reference",
    "capture_token_hash",
    "amount_value",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}
