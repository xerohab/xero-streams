{
  "name": "LiveStream",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "stream_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "upcoming_date": {
      "type": "string",
      "format": "date"
    },
    "upcoming_time": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "stream_url"
  ]
}