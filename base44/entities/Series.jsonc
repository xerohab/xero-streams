{
  "name": "Series",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Series title"
    },
    "description": {
      "type": "string",
      "description": "Series description"
    },
    "cover_image": {
      "type": "string",
      "description": "URL for the series cover image"
    },
    "category": {
      "type": "string",
      "enum": [
        "action",
        "comedy",
        "drama",
        "documentary",
        "horror",
        "sci-fi",
        "thriller",
        "education",
        "music",
        "crime",
        "mystery",
        "fantasy",
        "romance",
        "animation",
        "adventure",
        "other"
      ],
      "description": "Series category (legacy single-genre enum)"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multiple genre tags for this series"
    },
    "franchise_id": {
      "type": "string",
      "description": "ID of the franchise/collection this series belongs to"
    },
    "is_adult": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is 18+ adult content, only shown to age-verified users"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within franchise"
    },
    "release_year": {
      "type": "number"
    },
    "cast": {
      "type": "string",
      "description": "Comma-separated list of cast members (legacy)"
    },
    "main_cast": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lead actors for this series"
    },
    "guest_stars": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notable guest stars across the series"
    },
    "director_or_creator": {
      "type": "string",
      "description": "Creator or showrunner of the series"
    },
    "age_rating": {
      "type": "string",
      "description": "Content rating e.g. TV-MA, TV-14"
    },
    "runtime_or_episodes": {
      "type": "string",
      "description": "Episode count e.g. '10 Episodes' or average runtime"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "content_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last genuine admin edit, used for 'UPDATED' badging"
    }
  },
  "required": [
    "title"
  ]
}