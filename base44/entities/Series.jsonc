{
  "name": "Series",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Series title"
    },
    "description": {
      "type": "string",
      "description": "Series description"
    },
    "cover_image": {
      "type": "string",
      "description": "URL for the series cover image"
    },
    "category": {
      "type": "string",
      "enum": [
        "action",
        "comedy",
        "drama",
        "documentary",
        "horror",
        "sci-fi",
        "thriller",
        "education",
        "music",
        "crime",
        "mystery",
        "fantasy",
        "romance",
        "animation",
        "adventure",
        "other"
      ],
      "description": "Series category"
    },
    "franchise_id": {
      "type": "string",
      "description": "ID of the franchise/collection this series belongs to"
    },
    "is_adult": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is 18+ adult content, only shown to age-verified users"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within franchise"
    }
  },
  "required": [
    "title"
  ]
}