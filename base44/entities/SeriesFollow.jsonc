{
  "name": "SeriesFollow",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "series_id"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}