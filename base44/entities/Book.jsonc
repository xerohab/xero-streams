{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Book title"
    },
    "description": {
      "type": "string",
      "description": "Book description"
    },
    "price": {
      "type": "number",
      "description": "Price of the book (legacy or default)"
    },
    "price_word": {
      "type": "number",
      "description": "Price for Word Document format"
    },
    "price_ebook": {
      "type": "number",
      "description": "Price for Ebook format"
    },
    "cover_image": {
      "type": "string",
      "description": "URL to the cover image"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the book file (legacy or default)"
    },
    "file_url_word": {
      "type": "string",
      "description": "URL to the Word Document file"
    },
    "file_url_ebook": {
      "type": "string",
      "description": "URL to the Ebook file"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "author_id": {
      "type": "string",
      "description": "ID of the BookAuthor"
    }
  },
  "required": [
    "title"
  ]
}