{
  "name": "Image",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Image title"
    },
    "description": {
      "type": "string",
      "description": "Image description"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the image"
    },
    "series_id": {
      "type": "string",
      "description": "ID of the series this image belongs to (optional)"
    },
    "is_adult": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is 18+ adult content"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "title",
    "image_url"
  ]
}