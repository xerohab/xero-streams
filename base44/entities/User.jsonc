{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "age_verification_requested": {
      "type": "boolean",
      "default": false
    },
    "date_of_birth": {
      "type": "string"
    },
    "favourites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_color": {
      "type": "string",
      "default": "red"
    },
    "homepage_rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}