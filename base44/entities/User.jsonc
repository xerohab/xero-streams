{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "username": {
      "type": "string"
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "age_verification_requested": {
      "type": "boolean",
      "default": false
    },
    "date_of_birth": {
      "type": "string"
    },
    "favourites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favourite_series": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favourite_franchises": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_color": {
      "type": "string",
      "default": "red"
    },
    "homepage_rows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weekly_digest_opt_out": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has opted out of the weekly content digest email"
    }
  },
  "required": []
}