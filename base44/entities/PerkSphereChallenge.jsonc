{
  "name": "PerkSphereChallenge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Local Base44 user ID that initiated the consent"
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 hash of the Perk Sphere connection code; raw code is never stored"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "expired"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Local expiry window for the consent session (defense-in-depth)"
    }
  },
  "required": [
    "user_id",
    "code_hash",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_only"
      }
    }
  }
}
