{
  "name": "StreamingDevice",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "last_seen": {
      "type": "number"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "device_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}