{
  "name": "Review",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "series",
        "franchise"
      ]
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "content_id",
    "content_type",
    "rating"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}