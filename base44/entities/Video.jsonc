{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "franchise_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string",
      "description": "ID of VideoCategory"
    },
    "episode_number": {
      "type": "number"
    },
    "duration": {
      "type": "string"
    },
    "quality": {
      "type": "string",
      "enum": [
        "CAM",
        "HD",
        "Full HD",
        "4K",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "Video quality resolution"
    },
    "quality_notes": {
      "type": "string",
      "description": "Extra information such as Chinese subs etc."
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_adult": {
      "type": "boolean",
      "default": false
    },
    "content_type": {
      "type": "string",
      "enum": [
        "movie",
        "episode"
      ],
      "default": "movie"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "coming_soon": {
      "type": "boolean",
      "default": false
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "release_year": {
      "type": "number"
    },
    "cast": {
      "type": "string",
      "description": "Comma-separated list of cast members"
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "number"
    },
    "download_url": {
      "type": "string"
    },
    "intro_start": {
      "type": "number"
    },
    "intro_end": {
      "type": "number"
    },
    "recap_start": {
      "type": "number"
    },
    "recap_end": {
      "type": "number"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}