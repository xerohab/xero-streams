{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "series_id": {
      "type": "string"
    },
    "franchise_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string",
      "description": "ID of VideoCategory (legacy single-genre reference)"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multiple genre tags for this content"
    },
    "episode_number": {
      "type": "number"
    },
    "season_number": {
      "type": "number",
      "description": "Season number for TV episodes"
    },
    "duration": {
      "type": "string"
    },
    "quality": {
      "type": "string",
      "enum": [
        "CAM",
        "HD",
        "Full HD",
        "4K",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "Video quality resolution"
    },
    "quality_notes": {
      "type": "string",
      "description": "Extra information such as Chinese subs etc."
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_adult": {
      "type": "boolean",
      "default": false
    },
    "content_type": {
      "type": "string",
      "enum": [
        "movie",
        "episode"
      ],
      "default": "movie"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "coming_soon": {
      "type": "boolean",
      "default": false
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "release_year": {
      "type": "number"
    },
    "cast": {
      "type": "string",
      "description": "Comma-separated list of cast members (legacy)"
    },
    "main_cast": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lead actors for this content"
    },
    "guest_stars": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Guest appearances, notable for specific episodes"
    },
    "director_or_creator": {
      "type": "string",
      "description": "Director (movie) or creator/showrunner (TV)"
    },
    "age_rating": {
      "type": "string",
      "description": "Content rating e.g. PG-13, TV-MA"
    },
    "runtime_or_episodes": {
      "type": "string",
      "description": "Runtime e.g. '120 mins' or episode count e.g. '10 Episodes'"
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "number"
    },
    "download_url": {
      "type": "string"
    },
    "intro_start": {
      "type": "number"
    },
    "intro_end": {
      "type": "number"
    },
    "recap_start": {
      "type": "number"
    },
    "recap_end": {
      "type": "number"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "content_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last genuine admin edit, used for 'UPDATED' badging"
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}