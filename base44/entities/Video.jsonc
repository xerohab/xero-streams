{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "description": {
      "type": "string",
      "description": "Video description"
    },
    "video_url": {
      "type": "string",
      "description": "URL of the video (uploaded or external link)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "series_id": {
      "type": "string",
      "description": "ID of the series this video belongs to"
    },
    "franchise_id": {
      "type": "string",
      "description": "ID of the franchise this standalone movie belongs to"
    },
    "episode_number": {
      "type": "number",
      "description": "Episode number within the series"
    },
    "duration": {
      "type": "string",
      "description": "Video duration (e.g. 45:00)"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this video is featured on the hero banner"
    },
    "is_adult": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is 18+ adult content, only shown to age-verified users"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "movie",
        "episode"
      ],
      "default": "movie",
      "description": "Whether this is a standalone movie or a series episode"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within franchise or series"
    },
    "coming_soon": {
      "type": "boolean",
      "default": false,
      "description": "Mark as coming soon \u2014 hides play button until video_url is added"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Planned release date for coming soon content"
    }
  },
  "required": [
    "title"
  ]
}